@{
    ViewData["Title"] = "AI Legal Information Assistant";
}
<div class="container py-5">
    <div class="card border-0 shadow-sm rounded-4 mx-auto" style="max-width: 820px;">
        <div class="card-header bg-navy text-white rounded-top-4 p-4">
            <h4 class="mb-1 fw-bold"><i class="fa-solid fa-robot text-saffron me-2"></i>AI Legal Information Assistant</h4>
            <p class="small text-white-50 mb-0">Ask about Indian legal terminology, NALSA free legal aid, Lok Adalats, eCourts CNR tracking, or NyayaSetu workflows.</p>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-warning small border-0 mb-3">
                <i class="fa-solid fa-scale-balanced me-1"></i>
                <strong>Notice:</strong> This assistant provides general legal information grounded in public official portals and does <strong>not</strong> replace a licensed advocate.
            </div>
            <div id="chatMessages" class="border rounded-3 p-3 mb-3 bg-light" style="min-height: 280px; max-height: 420px; overflow-y: auto;">
                <div class="mb-3">
                    <span class="badge bg-primary mb-1">NyayaSetu Assistant</span>
                    <div class="p-3 bg-white rounded-3 shadow-sm small">
                        Hello! Try asking: <em>"Who is eligible for free legal aid?"</em>, <em>"What is a Lok Adalat?"</em>, <em>"What is an affidavit?"</em>, or <em>"How do I check eCourts case status?"</em>
                    </div>
                </div>
            </div>
            <form id="assistantForm" class="input-group">
                <input type="text" id="assistantInput" class="form-control" placeholder="Type your legal information question..." required />
                <button type="submit" class="btn btn-primary px-4">Ask</button>
            </form>
        </div>
    </div>
</div>
