@{
    ViewData["Title"] = "AI Nyaya Sahayak - Legal Information Assistant";
}
<div class="container py-5">
    <div class="mb-4 text-center">
        <span class="badge bg-warning text-dark px-3 py-2 fw-semibold mb-2">
            <i class="fa-solid fa-robot me-1"></i>AI Citizen Legal Assistant
        </span>
        <h2 class="fw-bold" style="color: var(--nyaya-navy);">AI Nyaya Sahayak (न्याय सहायक)</h2>
        <p class="text-muted mx-auto" style="max-width: 650px;">
            Instant, plain-language guidance on Indian legal terminology, NALSA free legal aid eligibility, eCourts CNR tracking procedures, and NyayaSetu digital workflows.
        </p>
    </div>

    <div class="card stat-card rounded-4 mx-auto shadow-sm overflow-hidden" style="max-width: 860px;">
        <div class="p-4 border-bottom text-white d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #07172C 0%, #0A2540 100%);">
            <div class="d-flex align-items-center gap-3">
                <div class="action-card-icon bg-warning text-dark mb-0">
                    <i class="fa-solid fa-robot fs-4"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold text-white">AI Legal Information Assistant</h5>
                    <small class="text-white-50">Grounded in verified official Ministry and NALSA portals</small>
                </div>
            </div>
            <span class="badge bg-success-subtle text-success border border-success-subtle">
                <i class="fa-solid fa-circle-dot me-1"></i>Active 24x7
            </span>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-warning small border-0 mb-3" style="background-color: var(--nyaya-surface-subtle); border-left: 4px solid var(--nyaya-saffron) !important;">
                <i class="fa-solid fa-scale-balanced me-1 text-warning"></i>
                <strong>Statutory Advisory:</strong> This assistant provides general legal guidance and educational information. It is <strong>not</strong> a substitute for formal legal advice from a licensed advocate.
            </div>

            <!-- Chat Message Box -->
            <div id="chatMessages" class="border rounded-3 p-3 mb-3" style="min-height: 320px; max-height: 460px; overflow-y: auto; background-color: var(--nyaya-surface-subtle); border-color: var(--nyaya-border) !important;">
                <div class="mb-3">
                    <div class="small fw-semibold text-primary mb-1">
                        <i class="fa-solid fa-robot me-1"></i>NyayaSetu Sahayak
                    </div>
                    <div class="p-3 rounded-3 shadow-sm small chat-bubble-assistant" style="max-width: 85%;">
                        Namaste! I am your <strong>NyayaSetu Legal Information Sahayak</strong>. 
                        <div class="mt-2">You can ask questions such as:</div>
                        <ul class="mb-2 mt-1 ps-3">
                            <li><em>"Who is eligible for free legal aid under Section 12?"</em></li>
                            <li><em>"What is a Lok Adalat and how does pre-litigation mediation work?"</em></li>
                            <li><em>"How do I track my case status using an eCourts CNR number?"</em></li>
                            <li><em>"What documents do I need to renew a Notary certificate?"</em></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Question Input Form -->
            <form id="assistantForm" class="input-group input-group-lg shadow-sm">
                <input type="text" id="assistantInput" class="form-control" placeholder="Type your legal query (e.g. Free legal aid eligibility in Hindi/English)..." required />
                <button type="submit" class="btn btn-primary px-4 fw-bold">
                    <i class="fa-solid fa-paper-plane me-1"></i>Ask Sahayak
                </button>
            </form>
        </div>
    </div>
</div>