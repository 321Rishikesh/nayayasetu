@model List<ApplicationCategory>
@{
    ViewData["Title"] = "Legal Services";
}
<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-navy mb-1">Citizen Legal Services Directory</h2>
            <p class="text-muted mb-0">Browse available digital application categories and submit online.</p>
        </div>
        <form method="get" class="d-flex gap-2">
            <input type="text" name="q" value="@ViewBag.Query" class="form-control" placeholder="Search services..." />
            <button type="submit" class="btn btn-primary">Filter</button>
        </form>
    </div>
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-primary-subtle text-primary align-self-start mb-2">@(item.DefaultDepartment?.Name ?? "General")</span>
                        <h5 class="fw-bold text-navy">@item.Name</h5>
                        <p class="small text-muted flex-grow-1">@item.Description</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <small class="text-secondary"><i class="fa-regular fa-clock me-1"></i>~@item.EstimatedProcessingDays days</small>
                            <a asp-controller="Applications" asp-action="Create" class="btn btn-sm btn-primary">Start Application</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
