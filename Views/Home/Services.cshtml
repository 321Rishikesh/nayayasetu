@model List<ApplicationCategory>
@{
    ViewData["Title"] = "Citizen Legal Services Directory";
}
<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <span class="badge bg-primary-subtle text-primary px-3 py-2 fw-semibold mb-2">Service Catalog</span>
            <h2 class="fw-bold mb-1" style="color: var(--nyaya-navy);"><i class="fa-solid fa-scale-balanced text-warning me-2"></i>Citizen Legal Services Directory</h2>
            <p class="text-muted mb-0">Browse online statutory services across the Ministry of Law and Justice departments and apply digitally.</p>
        </div>
        <form method="get" class="d-flex gap-2">
            <input type="text" name="q" value="@ViewBag.Query" class="form-control" placeholder="Search service name or keyword..." style="min-width: 250px;" />
            <button type="submit" class="btn btn-primary fw-semibold"><i class="fa-solid fa-filter me-1"></i>Filter</button>
        </form>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card stat-card h-100 p-4 rounded-4 shadow-sm">
                    <div class="d-flex flex-column h-100">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-primary-subtle text-primary fw-bold">@(item.DefaultDepartment?.Name ?? "Ministry General")</span>
                            <span class="badge bg-secondary-subtle text-dark border"><i class="fa-regular fa-clock me-1"></i>~@item.EstimatedProcessingDays days</span>
                        </div>
                        <h5 class="fw-bold mb-2" style="color: var(--nyaya-navy);">@item.Name</h5>
                        <p class="small text-muted flex-grow-1 mb-4">@item.Description</p>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top" style="border-color: var(--nyaya-border) !important;">
                            <span class="small text-muted"><i class="fa-solid fa-file-shield text-success me-1"></i>Secure Upload</span>
                            <a asp-controller="Applications" asp-action="Create" class="btn btn-sm btn-primary fw-semibold">
                                Start Application <i class="fa-solid fa-arrow-right ms-1 small"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>