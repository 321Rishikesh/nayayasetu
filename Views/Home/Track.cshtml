@model TrackApplicationViewModel
@{
    ViewData["Title"] = "Track Application Status";
    var stages = new[]
    {
        ApplicationStatus.Submitted,
        ApplicationStatus.UnderReview,
        ApplicationStatus.Verified,
        ApplicationStatus.Approved,
        ApplicationStatus.Resolved
    };
}
<div class="container py-5">
    <!-- Breadcrumb & Header -->
    <div class="mb-4">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 fw-semibold mb-2">Public Verification Service</span>
        <h2 class="fw-bold" style="color: var(--nyaya-navy);"><i class="fa-solid fa-magnifying-glass-location text-warning me-2"></i>Smart Application Tracking Portal</h2>
        <p class="text-muted">Enter your unique NyayaSetu Tracking ID to inspect real-time departmental review stages, document verification outcomes, and officer remarks.</p>
    </div>

    <!-- Tracking Input Card -->
    <div class="card stat-card p-4 p-md-5 mb-4 rounded-4 shadow-sm">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-9">
                <label class="form-label fw-semibold small text-muted">NyayaSetu Unique Application Tracking ID</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-transparent border-end-0 text-primary">
                        <i class="fa-solid fa-qrcode"></i>
                    </span>
                    <input type="text" name="trackingId" value="@Model.TrackingId" class="form-control border-start-0" placeholder="e.g. NYS-2026-1001" required />
                </div>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Track Status
                </button>
            </div>
        </form>
        <div class="mt-3 small text-muted d-flex flex-wrap align-items-center gap-2">
            <span class="fw-semibold">Sample Tracking IDs:</span>
            <a asp-action="Track" asp-route-trackingId="NYS-2026-1001" class="badge bg-primary-subtle text-primary text-decoration-none">NYS-2026-1001</a>
            <a asp-action="Track" asp-route-trackingId="NYS-2026-1002" class="badge bg-success-subtle text-success text-decoration-none">NYS-2026-1002</a>
            <a asp-action="Track" asp-route-trackingId="NYS-2026-1003" class="badge bg-warning-subtle text-warning text-decoration-none">NYS-2026-1003</a>
        </div>
    </div>

    @if (Model.Searched && Model.Application == null)
    {
        <div class="alert alert-warning rounded-4 shadow-sm p-4">
            <div class="d-flex gap-3 align-items-center">
                <i class="fa-solid fa-triangle-exclamation fs-3 text-warning"></i>
                <div>
                    <h5 class="fw-bold mb-1">Application Record Not Found</h5>
                    <p class="mb-0 text-muted small">No record was found for Tracking ID <strong>@Model.TrackingId</strong>. Please ensure the tracking ID follows the <code>NYS-YYYY-XXXX</code> format and retry.</p>
                </div>
            </div>
        </div>
    }
    else if (Model.Application != null)
    {
        var app = Model.Application;
        var statusBadgeClass = app.Status == ApplicationStatus.Resolved ? "bg-success text-white"
            : app.Status == ApplicationStatus.Approved ? "bg-primary text-white"
            : app.Status == ApplicationStatus.Rejected ? "bg-danger text-white"
            : "bg-warning text-dark";

        <div class="card stat-card rounded-4 p-4 p-md-5 shadow-sm">
            <!-- Header Summary Row -->
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4 pb-3 border-bottom" style="border-color: var(--nyaya-border) !important;">
                <div>
                    <span class="badge bg-primary px-3 py-2 fs-6 mb-2">@app.TrackingId</span>
                    <h3 class="fw-bold mb-1" style="color: var(--nyaya-navy);">@app.Title</h3>
                    <div class="small text-muted d-flex flex-wrap gap-3 mt-2">
                        <span><i class="fa-solid fa-building-columns text-primary me-1"></i><strong>Department:</strong> @(app.Department?.Name ?? "General")</span>
                        <span><i class="fa-solid fa-tag text-primary me-1"></i><strong>Category:</strong> @(app.Category?.Name ?? "Standard")</span>
                        <span><i class="fa-regular fa-calendar-check text-primary me-1"></i><strong>Submitted:</strong> @app.SubmissionDate.ToString("dd MMM yyyy, HH:mm")</span>
                    </div>
                </div>
                <div class="text-end">
                    <span class="badge @statusBadgeClass fs-6 px-3 py-2 rounded-pill">
                        <i class="fa-solid fa-circle-dot me-1"></i>@app.Status
                    </span>
                    <div class="small text-muted mt-2">
                        Target SLA: <strong>@(app.Category?.EstimatedProcessingDays ?? 15) days</strong>
                    </div>
                </div>
            </div>

            <!-- Visual Progress Stages Pipeline -->
            <h5 class="fw-bold mb-3" style="color: var(--nyaya-navy);"><i class="fa-solid fa-bars-progress me-2 text-primary"></i>Application Progress Pipeline</h5>
            <div class="row g-2 text-center mb-5">
                @foreach (var st in stages)
                {
                    var isRejected = app.Status == ApplicationStatus.Rejected;
                    var reached = !isRejected && ((int)app.Status >= (int)st);
                    var isCurrent = !isRejected && app.Status == st;
                    var stepColorClass = reached ? "bg-primary text-white border-primary" : "bg-light-subtle text-muted border";
                    if (isCurrent) stepColorClass = "bg-success text-white border-success shadow-sm";

                    <div class="col">
                        <div class="p-3 rounded-3 @stepColorClass h-100 d-flex flex-column justify-content-center">
                            <i class="fa-solid @(reached ? "fa-circle-check" : "fa-circle") mb-1 fs-5"></i>
                            <div class="small fw-bold">@st</div>
                        </div>
                    </div>
                }
            </div>

            <!-- Remarks & Review Status -->
            @if (!string.IsNullOrWhiteSpace(app.OfficerRemarks))
            {
                <div class="p-3 rounded-3 mb-4" style="background-color: var(--nyaya-surface-subtle); border-left: 4px solid var(--nyaya-blue);">
                    <div class="small text-uppercase text-muted fw-bold mb-1">
                        <i class="fa-solid fa-comment-dots text-primary me-1"></i>Latest Department Officer Remarks
                    </div>
                    <div class="fw-semibold" style="color: var(--nyaya-text);">@app.OfficerRemarks</div>
                </div>
            }

            <!-- Application Progress Timeline -->
            <h5 class="fw-bold mb-3" style="color: var(--nyaya-navy);"><i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i>Audit Trail &amp; Lifecycle Events</h5>
            <div class="ps-2">
                @foreach (var h in app.History.OrderByDescending(x => x.ChangedAt))
                {
                    <div class="pb-3 ps-3 border-start border-3 border-primary position-relative">
                        <div class="d-flex flex-wrap justify-content-between align-items-baseline">
                            <strong style="color: var(--nyaya-navy); font-size: 0.95rem;">@h.Status</strong>
                            <small class="text-muted">@h.ChangedAt.ToString("dd MMM yyyy, HH:mm")</small>
                        </div>
                        <p class="small text-muted mb-0 mt-1">@h.Remarks</p>
                    </div>
                }
            </div>
        </div>
    }
</div>