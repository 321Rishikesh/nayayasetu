@{
    ViewData["Title"] = "Contact & Directory - Ministry of Law & Justice";
}
<div class="container py-5">
    <div class="mb-4">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 fw-semibold mb-2">Helpdesk &amp; Directory</span>
        <h2 class="fw-bold" style="color: var(--nyaya-navy);"><i class="fa-solid fa-address-book text-warning me-2"></i>Ministry Contact &amp; Public Directory</h2>
        <p class="text-muted">Access contact details for departmental secretariats, public grievance nodal officers, and legal aid helplines.</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card stat-card rounded-4 p-4 h-100 shadow-sm">
                <span class="badge bg-primary-subtle text-primary px-3 py-1 fw-bold align-self-start mb-3">DLA</span>
                <h5 class="fw-bold mb-2" style="color: var(--nyaya-navy);">Department of Legal Affairs</h5>
                <p class="small text-muted mb-3">Shastri Bhawan, New Delhi - 110001</p>
                <div class="small text-muted mt-auto">
                    <div><i class="fa-solid fa-envelope text-primary me-2"></i>dla-demo@nyayasetu.local</div>
                    <div class="mt-1"><i class="fa-solid fa-phone text-primary me-2"></i>+91-11-23387948</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card rounded-4 p-4 h-100 shadow-sm">
                <span class="badge bg-success-subtle text-success px-3 py-1 fw-bold align-self-start mb-3">LEG</span>
                <h5 class="fw-bold mb-2" style="color: var(--nyaya-navy);">Legislative Department</h5>
                <p class="small text-muted mb-3">Shastri Bhawan, New Delhi - 110001</p>
                <div class="small text-muted mt-auto">
                    <div><i class="fa-solid fa-envelope text-success me-2"></i>legislative-demo@nyayasetu.local</div>
                    <div class="mt-1"><i class="fa-solid fa-phone text-success me-2"></i>+91-11-23384617</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card rounded-4 p-4 h-100 shadow-sm">
                <span class="badge bg-warning-subtle text-warning px-3 py-1 fw-bold align-self-start mb-3">DOJ</span>
                <h5 class="fw-bold mb-2" style="color: var(--nyaya-navy);">Department of Justice</h5>
                <p class="small text-muted mb-3">Jaisalmer House, 26 Man Singh Road, New Delhi</p>
                <div class="small text-muted mt-auto">
                    <div><i class="fa-solid fa-envelope text-warning me-2"></i>doj-demo@nyayasetu.local</div>
                    <div class="mt-1"><i class="fa-solid fa-phone text-warning me-2"></i>+91-11-23072149</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card stat-card rounded-4 p-4 p-md-5 shadow-sm">
        <h4 class="fw-bold mb-3" style="color: var(--nyaya-navy);"><i class="fa-solid fa-graduation-cap text-warning me-2"></i>NyayaSetu Academic Prototype Inquiries</h4>
        <p class="text-muted" style="line-height: 1.8;">
            NyayaSetu is an educational/academic prototype engineered in ASP.NET Core &amp; EF Core. If evaluating this prototype for viva, presentations, or technical review, use the contact channels below:
        </p>
        <div class="row g-3 small">
            <div class="col-md-4">
                <div class="p-3 rounded-3" style="background-color: var(--nyaya-surface-subtle); border: 1px solid var(--nyaya-border);">
                    <div class="fw-bold text-primary">Prototype Helpdesk</div>
                    <div class="text-muted">support-demo@nyayasetu.local</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 rounded-3" style="background-color: var(--nyaya-surface-subtle); border: 1px solid var(--nyaya-border);">
                    <div class="fw-bold text-primary">Languages Supported</div>
                    <div class="text-muted">English, Hindi (हिन्दी), Punjabi (ਪੰਜਾਬੀ)</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 rounded-3" style="background-color: var(--nyaya-surface-subtle); border: 1px solid var(--nyaya-border);">
                    <div class="fw-bold text-primary">Availability</div>
                    <div class="text-muted">24/7 Local &amp; Hosted Prototype Demo</div>
                </div>
            </div>
        </div>
    </div>
</div>