@model HomeIndexViewModel
@inject ILocalizationService Loc
@{
    var lang = Context.Request.Cookies["NyayaSetu.Lang"] ?? "en";
    ViewData["Title"] = Loc.Get("NavHome", lang);
}

<!-- Hero Section -->
<section class="hero-nyaya text-white py-5">
    <div class="container py-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge bg-saffron text-dark mb-3 px-3 py-2 fw-semibold">
                    <i class="fa-solid fa-scale-balanced me-1"></i>Academic Prototype — Digital Justice Portal
                </span>
                <h1 class="display-5 fw-bold mb-3">@Loc.Get("HeroTitle", lang)</h1>
                <p class="lead text-white-50 mb-4">@Loc.Get("HeroSubtitle", lang)</p>

                <form asp-controller="Home" asp-action="Track" method="get" class="input-group input-group-lg shadow-sm mb-3">
                    <input type="text" name="trackingId" id="heroSearchInput" class="form-control border-0" placeholder="@Loc.Get("TrackPlaceholder", lang)" aria-label="Tracking ID or search" />
                    <button type="button" class="btn btn-light border-start" id="voiceSearchBtn" title="Voice Search">
                        <i class="fa-solid fa-microphone text-primary"></i>
                    </button>
                    <button type="submit" class="btn btn-saffron fw-semibold px-4">@Loc.Get("SearchBtn", lang)</button>
                </form>

                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-light fw-semibold" asp-controller="Account" asp-action="Register"><i class="fa-solid fa-user-plus me-1"></i>Citizen Registration</a>
                    <a class="btn btn-outline-light" asp-controller="Home" asp-action="LegalAidInfo"><i class="fa-solid fa-hands-holding-circle me-1"></i>Free Legal Aid</a>
                    <a class="btn btn-outline-light" asp-controller="Assistant" asp-action="Index"><i class="fa-solid fa-robot me-1"></i>Ask AI Legal Info</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card border-0 shadow-lg rounded-4 text-dark p-4">
                    <h6 class="text-uppercase text-muted fw-bold small mb-3">Portal Snapshot</h6>
                    <div class="row g-3 text-center">
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="h3 fw-bold text-primary mb-0">@Model.TotalApplicationsProcessed</div>
                                <small class="text-muted">Applications Logged</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="h3 fw-bold text-primary mb-0">@Model.ActiveDepartmentsCount</div>
                                <small class="text-muted">Core Departments</small>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="small text-muted">
                        <strong>Quick Demo Tracking ID:</strong>
                        <a asp-controller="Home" asp-action="Track" asp-route-trackingId="NYS-2026-1001" class="badge bg-primary text-decoration-none ms-1">NYS-2026-1001</a>
                        <a asp-controller="Home" asp-action="Track" asp-route-trackingId="NYS-2026-1002" class="badge bg-success text-decoration-none ms-1">NYS-2026-1002</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Ministry Introduction & Departments -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-navy">Core Ministry Departments</h2>
            <p class="text-muted mx-auto" style="max-width: 680px;">
                NyayaSetu models the three primary functional wings of legal administration to streamline citizen applications, statutory services, and access to justice.
            </p>
        </div>
        <div class="row g-4">
            @foreach (var dept in Model.Departments)
            {
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 card-hover p-3">
                        <div class="card-body">
                            <span class="badge bg-primary-subtle text-primary mb-2">@dept.Code</span>
                            <h5 class="fw-bold text-navy">@dept.Name</h5>
                            <p class="text-muted small">@dept.Description</p>
                            <div class="small text-secondary mt-3">
                                <i class="fa-solid fa-user-tie me-1"></i>@(dept.HeadOfDepartment ?? "Department Head")
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Important Legal Services -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="fw-bold text-navy mb-1">Important Legal Services</h2>
                <p class="text-muted mb-0">Apply online, upload documents securely, and track every stage.</p>
            </div>
            <a asp-controller="Home" asp-action="Services" class="btn btn-outline-primary btn-sm">View All Services</a>
        </div>
        <div class="row g-3">
            @foreach (var cat in Model.Categories.Take(6))
            {
                <div class="col-md-6 col-lg-4">
                    <div class="p-4 border rounded-4 h-100 bg-light-subtle">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="fw-bold text-navy mb-0">@cat.Name</h6>
                            <span class="badge bg-secondary-subtle text-dark">~@cat.EstimatedProcessingDays days</span>
                        </div>
                        <p class="small text-muted mb-3">@cat.Description</p>
                        <a asp-controller="Applications" asp-action="Create" class="btn btn-sm btn-primary">Apply Online</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Legal Aid + Announcements -->
<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-navy text-white">
                    <span class="badge bg-saffron text-dark align-self-start mb-2">Access to Justice</span>
                    <h3 class="fw-bold">Free Legal Aid &amp; Consultations</h3>
                    <p class="text-white-50">
                        Under the Legal Services Authorities Act, 1987, eligible citizens can access free legal representation, pre-litigation mediation, and Lok Adalat referrals.
                    </p>
                    <div class="d-flex flex-wrap gap-2 mt-auto">
                        <a asp-controller="LegalAid" asp-action="Create" class="btn btn-saffron fw-semibold">Request Legal Aid</a>
                        <a href="https://nalsa.gov.in/legal-aid/" target="_blank" rel="noopener" class="btn btn-outline-light">Official NALSA Portal <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
                    <h4 class="fw-bold text-navy mb-3"><i class="fa-solid fa-bullhorn text-saffron me-2"></i>Latest Announcements</h4>
                    @if (!Model.Announcements.Any())
                    {
                        <p class="text-muted small">No announcements published yet.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var ann in Model.Announcements)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between">
                                        <strong class="text-navy">@ann.Title</strong>
                                        <small class="text-muted">@ann.PublishedAt.ToString("dd MMM yyyy")</small>
                                    </div>
                                    <p class="small text-muted mb-0 mt-1">@ann.Summary</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FAQ Section -->
<section class="py-5 bg-white">
    <div class="container">
        <h2 class="fw-bold text-navy text-center mb-4">Frequently Asked Questions</h2>
        <div class="accordion mx-auto" id="faqAccordion" style="max-width: 820px;">
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">How do I track my legal service application?</button></h2>
                <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                    <div class="accordion-body small text-muted">Enter your unique tracking ID (e.g., NYS-2026-1001) on the Track Application page to view your current processing stage, assigned department, officer remarks, and full timeline.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">Are uploaded citizen documents publicly accessible?</button></h2>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body small text-muted">No. All uploaded PDF and image files are validated by extension, size, and binary header signature, stored outside the public web root, and served only after strict role and ownership authorization checks.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">Is NyayaSetu an official Government of India website?</button></h2>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body small text-muted">No. NyayaSetu is an academic software engineering prototype. For actual government services, use official portals such as lawmin.gov.in, doj.gov.in, nalsa.gov.in, and services.ecourts.gov.in.</div>
                </div>
            </div>
        </div>
    </div>
</section>
