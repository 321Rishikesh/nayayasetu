@model HomeIndexViewModel
@inject ILocalizationService Loc
@{
    var lang = Context.Request.Cookies["NyayaSetu.Lang"] ?? "en";
    ViewData["Title"] = Loc.Get("NavHome", lang);
}

<!-- Official Ministry Hero Section -->
<section class="hero-nyaya py-5">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <!-- Government Pillar Badges -->
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="hero-badge-gov">
                        <i class="fa-solid fa-scale-balanced me-1 text-warning"></i>Ministry of Law and Justice &bull; Digital India
                    </span>
                    <span class="hero-badge-gov">
                        <i class="fa-solid fa-shield-halved me-1 text-info"></i>Unified Citizen Legal Administration
                    </span>
                </div>

                <!-- Hero Headline -->
                <h1 class="display-5 fw-bold mb-3 text-white">
                    @Loc.Get("HeroTitle", lang)
                </h1>
                <p class="lead mb-4 text-white-50" style="font-size: 1.15rem;">
                    @Loc.Get("HeroSubtitle", lang)
                </p>

                <!-- Fast-Track Application & Grievance Search Bar -->
                <div class="hero-search-card mb-3">
                    <form asp-controller="Home" asp-action="Track" method="get" class="d-flex flex-column flex-sm-row gap-2">
                        <div class="input-group input-group-lg flex-grow-1 border-0">
                            <span class="input-group-text bg-transparent border-0 text-muted ps-3">
                                <i class="fa-solid fa-magnifying-glass text-primary"></i>
                            </span>
                            <input type="text" name="trackingId" id="heroSearchInput" class="form-control border-0 ps-1" placeholder="@Loc.Get("TrackPlaceholder", lang)" aria-label="Tracking ID" required />
                            <button type="button" class="btn btn-light border-0 px-3" id="voiceSearchBtn" title="Voice Search Assistance">
                                <i class="fa-solid fa-microphone text-primary"></i>
                            </button>
                        </div>
                        <button type="submit" class="btn btn-saffron px-4 py-2 text-nowrap fw-bold">
                            <i class="fa-solid fa-arrow-right me-1"></i>@Loc.Get("SearchBtn", lang)
                        </button>
                    </form>
                </div>

                <!-- Quick Tracking Chips & Direct CTAs -->
                <div class="d-flex flex-wrap align-items-center gap-2 text-white-50 small mb-4">
                    <span class="fw-semibold text-white"><i class="fa-solid fa-bolt me-1 text-warning"></i>Quick Demo Tracking IDs:</span>
                    <a asp-controller="Home" asp-action="Track" asp-route-trackingId="NYS-2026-1001" class="badge bg-white bg-opacity-10 text-white text-decoration-none border border-white border-opacity-25 px-2 py-1">NYS-2026-1001</a>
                    <a asp-controller="Home" asp-action="Track" asp-route-trackingId="NYS-2026-1002" class="badge bg-white bg-opacity-10 text-white text-decoration-none border border-white border-opacity-25 px-2 py-1">NYS-2026-1002</a>
                    <a asp-controller="Home" asp-action="Track" asp-route-trackingId="NYS-2026-1003" class="badge bg-white bg-opacity-10 text-white text-decoration-none border border-white border-opacity-25 px-2 py-1">NYS-2026-1003</a>
                </div>

                <div class="d-flex flex-wrap gap-3">
                    <a class="btn btn-primary btn-lg shadow-sm" asp-controller="Account" asp-action="Register">
                        <i class="fa-solid fa-user-plus me-1"></i>Register as Citizen
                    </a>
                    <a class="btn btn-outline-light btn-lg" asp-controller="Home" asp-action="LegalAidInfo">
                        <i class="fa-solid fa-hand-holding-heart me-1"></i>NALSA Legal Aid
                    </a>
                    <a class="btn btn-outline-light btn-lg" asp-controller="Assistant" asp-action="Index">
                        <i class="fa-solid fa-robot text-warning me-1"></i>AI Nyaya Sahayak
                    </a>
                </div>
            </div>

            <!-- Right: Ministry KPI Snapshot Card -->
            <div class="col-lg-5">
                <div class="card stat-card p-4 rounded-4 shadow-lg">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="fw-bold small text-uppercase" style="letter-spacing:0.06em; color: var(--nyaya-navy);">
                            <i class="fa-solid fa-chart-line me-1 text-warning"></i>Live Digital Justice Statistics
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="fa-solid fa-circle-dot fa-fade me-1"></i>Live Portal
                        </span>
                    </div>

                    <div class="row g-3 text-center mb-3">
                        <div class="col-6">
                            <div class="p-3 rounded-3" style="background-color: var(--nyaya-surface-subtle); border: 1px solid var(--nyaya-border);">
                                <div class="h2 fw-bold text-primary mb-0">@Model.TotalApplicationsProcessed</div>
                                <div class="small text-muted fw-semibold mt-1">Applications Processed</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-3" style="background-color: var(--nyaya-surface-subtle); border: 1px solid var(--nyaya-border);">
                                <div class="h2 fw-bold text-success mb-0">@Model.ActiveDepartmentsCount</div>
                                <div class="small text-muted fw-semibold mt-1">Ministry Wings</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-3" style="background-color: var(--nyaya-surface-subtle); border: 1px solid var(--nyaya-border);">
                                <div class="h2 fw-bold text-warning mb-0">24/7</div>
                                <div class="small text-muted fw-semibold mt-1">SLA Grievance Redressal</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-3" style="background-color: var(--nyaya-surface-subtle); border: 1px solid var(--nyaya-border);">
                                <div class="h2 fw-bold text-info mb-0">100%</div>
                                <div class="small text-muted fw-semibold mt-1">Transparent Tracking</div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 rounded-3 small" style="background-color: var(--nyaya-surface-subtle); border: 1px solid var(--nyaya-border);">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="fa-solid fa-shield-halved text-primary"></i>
                            <strong style="color: var(--nyaya-text);">Certified Information Security</strong>
                        </div>
                        <p class="mb-0 text-muted" style="font-size: 0.8rem;">
                            Citizen documents are hashed and protected with role-based authorization in accordance with Indian e-Governance standards.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 4 Core Citizen Service Pillars -->
<section class="py-5" style="background-color: var(--nyaya-surface-subtle); border-bottom: 1px solid var(--nyaya-border);">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge bg-primary-subtle text-primary px-3 py-2 fw-semibold mb-2">Citizen-Centric Governance</span>
            <h2 class="fw-bold" style="color: var(--nyaya-navy);">How Can NyayaSetu Assist You Today?</h2>
            <p class="text-muted mx-auto" style="max-width: 650px;">
                Access unified legal administrative workflows, transparent application lifecycle tracking, and free legal aid.
            </p>
        </div>

        <div class="row g-4">
            <!-- Card 1: Submit Application -->
            <div class="col-md-6 col-lg-3">
                <a asp-controller="Applications" asp-action="Create" class="action-card text-decoration-none">
                    <div class="action-card-icon bg-primary-subtle text-primary">
                        <i class="fa-solid fa-file-circle-plus"></i>
                    </div>
                    <h5 class="fw-bold mb-2" style="color: var(--nyaya-navy);">Legal Service Applications</h5>
                    <p class="small text-muted mb-4 flex-grow-1">
                        Apply online for notary certificates, legal document attestations, and certified gazette copies with zero paperwork.
                    </p>
                    <div class="d-flex align-items-center text-primary fw-semibold small">
                        <span>Apply Online</span>
                        <i class="fa-solid fa-arrow-right ms-2"></i>
                    </div>
                </a>
            </div>

            <!-- Card 2: Track Status -->
            <div class="col-md-6 col-lg-3">
                <a asp-controller="Home" asp-action="Track" class="action-card text-decoration-none">
                    <div class="action-card-icon bg-success-subtle text-success">
                        <i class="fa-solid fa-magnifying-glass-location"></i>
                    </div>
                    <h5 class="fw-bold mb-2" style="color: var(--nyaya-navy);">Track Status &amp; Timeline</h5>
                    <p class="small text-muted mb-4 flex-grow-1">
                        View real-time progress timelines, assigned officer remarks, verification status, and estimated completion dates.
                    </p>
                    <div class="d-flex align-items-center text-success fw-semibold small">
                        <span>Track Application</span>
                        <i class="fa-solid fa-arrow-right ms-2"></i>
                    </div>
                </a>
            </div>

            <!-- Card 3: Free Legal Aid (NALSA) -->
            <div class="col-md-6 col-lg-3">
                <a asp-controller="LegalAid" asp-action="Create" class="action-card text-decoration-none">
                    <div class="action-card-icon bg-warning-subtle text-warning">
                        <i class="fa-solid fa-hand-holding-heart"></i>
                    </div>
                    <h5 class="fw-bold mb-2" style="color: var(--nyaya-navy);">Free Legal Aid &amp; Lok Adalat</h5>
                    <p class="small text-muted mb-4 flex-grow-1">
                        Eligible citizens under Section 12 of LSA Act can access free legal representation, Lok Adalat, and consultation.
                    </p>
                    <div class="d-flex align-items-center text-warning fw-semibold small">
                        <span>Request Assistance</span>
                        <i class="fa-solid fa-arrow-right ms-2"></i>
                    </div>
                </a>
            </div>

            <!-- Card 4: AI Legal Assistant -->
            <div class="col-md-6 col-lg-3">
                <a asp-controller="Assistant" asp-action="Index" class="action-card text-decoration-none">
                    <div class="action-card-icon bg-info-subtle text-info">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <h5 class="fw-bold mb-2" style="color: var(--nyaya-navy);">AI Nyaya Sahayak</h5>
                    <p class="small text-muted mb-4 flex-grow-1">
                        Instant plain-language explanations of Indian legal terminology, eCourts CNR queries, and statutory procedures.
                    </p>
                    <div class="d-flex align-items-center text-info fw-semibold small">
                        <span>Ask AI Assistant</span>
                        <i class="fa-solid fa-arrow-right ms-2"></i>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Statutory Wings of Ministry of Law & Justice -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge bg-secondary-subtle text-secondary px-3 py-2 fw-semibold mb-2">Institutional Framework</span>
            <h2 class="fw-bold" style="color: var(--nyaya-navy);">Core Ministry Departments &amp; Functional Wings</h2>
            <p class="text-muted mx-auto" style="max-width: 680px;">
                NyayaSetu digitally integrates the three statutory wings of the Ministry of Law and Justice to deliver swift, transparent administrative workflows.
            </p>
        </div>

        <div class="row g-4">
            @foreach (var dept in Model.Departments)
            {
                <div class="col-md-4">
                    <div class="ministry-wing-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-primary-subtle text-primary px-3 py-1 fw-bold">@dept.Code</span>
                            <small class="text-success fw-semibold"><i class="fa-solid fa-circle-check me-1"></i>Active Wing</small>
                        </div>
                        <h4 class="fw-bold mb-2" style="color: var(--nyaya-navy);">@dept.Name</h4>
                        <p class="text-muted small mb-4">@dept.Description</p>
                        
                        <div class="pt-3 border-top small" style="border-color: var(--nyaya-border) !important;">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="fa-solid fa-user-tie text-primary"></i>
                                <strong style="color: var(--nyaya-text);">Head:</strong>
                                <span class="text-muted">@(dept.HeadOfDepartment ?? "Department Head")</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-envelope text-primary"></i>
                                <span class="text-muted text-truncate">@dept.ContactEmail</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Popular Citizen Legal Services Directory -->
<section class="py-5" style="background-color: var(--nyaya-surface-subtle); border-top: 1px solid var(--nyaya-border); border-bottom: 1px solid var(--nyaya-border);">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
            <div>
                <span class="badge bg-primary-subtle text-primary px-3 py-2 fw-semibold mb-2">Digital Services Directory</span>
                <h2 class="fw-bold mb-1" style="color: var(--nyaya-navy);">Important Citizen Legal Services</h2>
                <p class="text-muted mb-0">Apply online, upload supporting documents, and receive digitally attested certificates.</p>
            </div>
            <a asp-controller="Home" asp-action="Services" class="btn btn-outline-gov">
                <i class="fa-solid fa-list me-1"></i>View All Services
            </a>
        </div>

        <div class="row g-4">
            @foreach (var cat in Model.Categories.Take(6))
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card stat-card p-4 h-100">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-primary-subtle text-primary px-2 py-1">@(cat.DefaultDepartment?.Code ?? "GENERAL")</span>
                            <span class="badge bg-secondary-subtle text-dark border"><i class="fa-regular fa-clock me-1"></i>~@cat.EstimatedProcessingDays days SLA</span>
                        </div>
                        <h5 class="fw-bold mb-2" style="color: var(--nyaya-navy);">@cat.Name</h5>
                        <p class="small text-muted flex-grow-1 mb-3">@cat.Description</p>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top" style="border-color: var(--nyaya-border) !important;">
                            <span class="small text-muted">Online Verification</span>
                            <a asp-controller="Applications" asp-action="Create" class="btn btn-sm btn-primary">
                                Apply Now <i class="fa-solid fa-chevron-right ms-1 small"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Legal Aid & Announcements Row -->
<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <!-- Left Banner: Legal Aid Mission -->
            <div class="col-lg-6">
                <div class="card border-0 rounded-4 p-4 p-md-5 h-100 text-white position-relative overflow-hidden" 
                     style="background: linear-gradient(135deg, #07172C 0%, #0A2540 60%, #153965 100%);">
                    <span class="badge bg-warning text-dark align-self-start px-3 py-2 fw-bold mb-3">
                        <i class="fa-solid fa-scale-balanced me-1"></i>Access to Justice &bull; NALSA
                    </span>
                    <h3 class="fw-bold mb-3">Free Legal Aid &amp; Pre-Litigation Mediation</h3>
                    <p class="text-white-50 mb-4" style="line-height: 1.7;">
                        Under the Legal Services Authorities Act, 1987, citizens from marginalized backgrounds, women, children, industrial workers, and persons in custody are entitled to 100% free legal assistance and representation.
                    </p>
                    <div class="d-flex flex-wrap gap-2 mt-auto">
                        <a asp-controller="LegalAid" asp-action="Create" class="btn btn-saffron fw-bold">
                            <i class="fa-solid fa-hands-holding-circle me-1"></i>Apply for Free Legal Aid
                        </a>
                        <a href="https://nalsa.gov.in/legal-aid/" target="_blank" rel="noopener" class="btn btn-outline-light">
                            Official NALSA Portal <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right Box: Official Announcements -->
            <div class="col-lg-6">
                <div class="card stat-card rounded-4 p-4 p-md-5 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold mb-0" style="color: var(--nyaya-navy);">
                            <i class="fa-solid fa-bullhorn text-warning me-2"></i>Ministry Announcements
                        </h4>
                        <span class="badge bg-warning-subtle text-warning">Notice Board</span>
                    </div>

                    @if (!Model.Announcements.Any())
                    {
                        <div class="text-center py-4 text-muted small">No announcements published at this time.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var ann in Model.Announcements)
                            {
                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex justify-content-between align-items-baseline">
                                        <strong style="color: var(--nyaya-navy); font-size: 0.95rem;">@ann.Title</strong>
                                        <small class="text-muted text-nowrap ms-2">@ann.PublishedAt.ToString("dd MMM yyyy")</small>
                                    </div>
                                    <p class="small text-muted mb-0 mt-1">@ann.Summary</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Frequently Asked Questions -->
<section class="py-5" style="background-color: var(--nyaya-surface-subtle); border-top: 1px solid var(--nyaya-border);">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge bg-secondary-subtle text-secondary px-3 py-2 fw-semibold mb-2">Help &amp; Guidance</span>
            <h2 class="fw-bold" style="color: var(--nyaya-navy);">Frequently Asked Questions (FAQ)</h2>
            <p class="text-muted mx-auto" style="max-width: 600px;">
                Find clear answers to common questions regarding applications, document security, and legal aid eligibility.
            </p>
        </div>

        <div class="accordion mx-auto" id="faqAccordion" style="max-width: 840px;">
            <div class="accordion-item mb-3 rounded-3 overflow-hidden border" style="border-color: var(--nyaya-border) !important;">
                <h2 class="accordion-header">
                    <button class="accordion-button fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                        How do I track my legal service application?
                    </button>
                </h2>
                <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                    <div class="accordion-body small text-muted">
                        Enter your unique tracking ID (e.g., <code>NYS-2026-1001</code>) on the <strong>Track Application</strong> page to view your current processing stage, assigned department, officer remarks, and full timeline.
                    </div>
                </div>
            </div>

            <div class="accordion-item mb-3 rounded-3 overflow-hidden border" style="border-color: var(--nyaya-border) !important;">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                        Are uploaded citizen documents publicly accessible?
                    </button>
                </h2>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body small text-muted">
                        No. All uploaded PDF and image files are validated by extension, size, and binary header signature, stored outside the public web root, and served only after strict role and ownership authorization checks.
                    </div>
                </div>
            </div>

            <div class="accordion-item rounded-3 overflow-hidden border" style="border-color: var(--nyaya-border) !important;">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                        Who is eligible to receive free legal aid under Indian Law?
                    </button>
                </h2>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body small text-muted">
                        Under Section 12 of the Legal Services Authorities Act, 1987, eligibility covers women, children, members of SC/ST, persons with disabilities, victims of disasters/violence, industrial workmen, persons in custody, and citizens with annual income below prescribed statutory thresholds.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>