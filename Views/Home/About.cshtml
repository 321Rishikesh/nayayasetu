@{
    ViewData["Title"] = "About NyayaSetu & Ministry of Law and Justice";
}
<div class="container py-5">
    <!-- Header -->
    <div class="mb-4">
        <span class="badge bg-warning text-dark px-3 py-2 fw-semibold mb-2">
            <i class="fa-solid fa-graduation-cap me-1"></i>Academic Prototype &bull; Digital India Model
        </span>
        <h2 class="fw-bold" style="color: var(--nyaya-navy);">About NyayaSetu (न्यायसेतु)</h2>
        <p class="lead text-muted">A Smart Law &amp; Justice Management Platform connecting Indian citizens with unified legal administrative workflows, transparent application tracking, and free legal aid.</p>
    </div>

    <!-- Core Vision Card -->
    <div class="card stat-card rounded-4 p-4 p-md-5 mb-5 shadow-sm">
        <div class="row g-4 align-items-center">
            <div class="col-lg-8">
                <h4 class="fw-bold mb-3" style="color: var(--nyaya-navy);"><i class="fa-solid fa-scale-balanced text-warning me-2"></i>Empowering Citizens Through Digital Justice</h4>
                <p style="color: var(--nyaya-text); line-height: 1.8;">
                    <strong>NyayaSetu</strong> is engineered as a modern digital bridge between citizens and the administrative departments of the Ministry of Law and Justice, Government of India. The portal digitizes statutory application processing (notary certifications, legal attestations, gazette clarifications), incorporates automated grievance escalation against Service Level Agreements (SLAs), and facilitates access to free legal aid under the Legal Services Authorities Act, 1987.
                </p>
                <div class="alert alert-info border-0 mt-3 small">
                    <i class="fa-solid fa-circle-info me-2 text-info"></i>
                    <strong>Disclosure:</strong> NyayaSetu is an educational/academic software engineering capstone prototype. For statutory submissions and official government actions, citizens must utilize verified portals including <strong>lawmin.gov.in</strong>, <strong>doj.gov.in</strong>, <strong>nalsa.gov.in</strong>, and <strong>services.ecourts.gov.in</strong>.
                </div>
            </div>
            <div class="col-lg-4 text-center">
                <div class="p-4 rounded-4" style="background-color: var(--nyaya-surface-subtle); border: 1px solid var(--nyaya-border);">
                    <img src="~/images/emblem-india.svg" alt="India Emblem" width="70" height="90" class="mb-3" />
                    <h6 class="fw-bold mb-1" style="color: var(--nyaya-navy);">विधि एवं न्याय मंत्रालय</h6>
                    <small class="text-muted d-block">Ministry of Law and Justice</small>
                    <small class="text-muted">Government of India</small>
                </div>
            </div>
        </div>
    </div>

    <!-- 3 Core Functional Wings Breakdown -->
    <h3 class="fw-bold mb-4" style="color: var(--nyaya-navy);"><i class="fa-solid fa-building-columns text-primary me-2"></i>Institutional Architecture: The Three Ministry Wings</h3>
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="ministry-wing-card">
                <span class="badge bg-primary-subtle text-primary px-3 py-1 fw-bold mb-3">DLA</span>
                <h5 class="fw-bold mb-2" style="color: var(--nyaya-navy);">Department of Legal Affairs</h5>
                <p class="small text-muted mb-3">
                    Responsible for tendering legal advice to ministries, appointment of Law Officers &amp; Notaries, conducting central government litigation in courts, and administering arbitration treaties.
                </p>
                <div class="small fw-semibold text-primary">Head: Dr. Rajeshwar Sharma</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ministry-wing-card">
                <span class="badge bg-success-subtle text-success px-3 py-1 fw-bold mb-3">LEG</span>
                <h5 class="fw-bold mb-2" style="color: var(--nyaya-navy);">Legislative Department</h5>
                <p class="small text-muted mb-3">
                    Responsible for drafting government Bills, Ordinances, and statutory rules, publishing the Official Gazette of India, and translating Central Acts into official Indian languages.
                </p>
                <div class="small fw-semibold text-success">Head: Smt. Meenakshi Deshmukh</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ministry-wing-card">
                <span class="badge bg-warning-subtle text-warning px-3 py-1 fw-bold mb-3">DOJ</span>
                <h5 class="fw-bold mb-2" style="color: var(--nyaya-navy);">Department of Justice</h5>
                <p class="small text-muted mb-3">
                    Administers the National Mission for Justice Delivery, eCourts Project infrastructure, judicial appointments, Tele-Law services, and coordination with NALSA.
                </p>
                <div class="small fw-semibold text-warning">Head: Shri Harpreet Singh Gill</div>
            </div>
        </div>
    </div>

    <!-- Technology Stack Card -->
    <div class="card stat-card rounded-4 p-4 shadow-sm">
        <h5 class="fw-bold mb-3" style="color: var(--nyaya-navy);"><i class="fa-solid fa-code text-primary me-2"></i>Technical Implementation Details</h5>
        <div class="row g-3 small">
            <div class="col-md-3">
                <div class="p-3 rounded-3" style="background-color: var(--nyaya-surface-subtle); border: 1px solid var(--nyaya-border);">
                    <div class="fw-bold text-primary">Backend Architecture</div>
                    <div class="text-muted">ASP.NET Core 8.0 MVC (C#)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 rounded-3" style="background-color: var(--nyaya-surface-subtle); border: 1px solid var(--nyaya-border);">
                    <div class="fw-bold text-primary">Database &amp; ORM</div>
                    <div class="text-muted">Microsoft SQL Server &amp; EF Core 8.0</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 rounded-3" style="background-color: var(--nyaya-surface-subtle); border: 1px solid var(--nyaya-border);">
                    <div class="fw-bold text-primary">Security &amp; Auth</div>
                    <div class="text-muted">ASP.NET Core Identity &amp; RBAC</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 rounded-3" style="background-color: var(--nyaya-surface-subtle); border: 1px solid var(--nyaya-border);">
                    <div class="fw-bold text-primary">User Interface</div>
                    <div class="text-muted">Bootstrap 5.3.3 + Dual Theme Engine</div>
                </div>
            </div>
        </div>
    </div>
</div>