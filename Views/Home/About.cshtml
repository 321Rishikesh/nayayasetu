@{
    ViewData["Title"] = "About NyayaSetu";
}
<div class="container py-5">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <span class="badge bg-warning text-dark align-self-start mb-2">Academic Prototype Disclosure</span>
        <h2 class="fw-bold text-navy mb-3">About NyayaSetu</h2>
        <p>NyayaSetu – Smart Ministry of Law and Justice Management System is a full-stack academic prototype built with <strong>C#, ASP.NET Core 8.0 MVC, Entity Framework Core, ASP.NET Core Identity, and Microsoft SQL Server</strong>.</p>
        <p>Its goal is to demonstrate how citizen legal service applications, grievance redressal with automated SLA escalation, free legal aid eligibility &amp; consultation scheduling, secure private document verification, and administrative analytics can operate in a single modular web portal.</p>
        <div class="alert alert-info border-0 mt-3">
            <i class="fa-solid fa-circle-info me-2"></i>
            <strong>Important Notice:</strong> This system is strictly an educational/academic project prototype and does not represent or operate on behalf of the Government of India.
        </div>
    </div>
</div>
