@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h4 class="fw-bold text-navy mb-2">Reset Password</h4>
                <p class="small text-muted">Enter your registered email address to initiate the password recovery workflow.</p>
                <form asp-action="ForgotPassword" method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Request Password Reset</button>
                </form>
            </div>
        </div>
    </div>
</div>
