@model List<Application>
@{
    Layout = "_CitizenLayout";
    ViewData["Title"] = "My Applications";
}
<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-navy mb-0">My Submitted Applications</h5>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus me-1"></i>New Application</a>
    </div>
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">You have not submitted any applications yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle small">
                <thead class="table-light"><tr><th>Tracking ID</th><th>Title</th><th>Category</th><th>Department</th><th>Submitted</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var app in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">@app.TrackingId</td>
                        <td>@app.Title</td>
                        <td>@app.Category?.Name</td>
                        <td>@app.Department?.Name</td>
                        <td>@app.SubmissionDate.ToString("dd MMM yyyy")</td>
                        <td><span class="badge bg-info text-dark">@app.Status</span></td>
                        <td><a asp-action="Details" asp-route-id="@app.Id" class="btn btn-sm btn-outline-primary">Details</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
