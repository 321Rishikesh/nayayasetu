@model CreateApplicationViewModel
@{
    Layout = "_CitizenLayout";
    ViewData["Title"] = "Submit Legal Service Application";
}
<div class="card border-0 shadow-sm rounded-4 p-4 mx-auto" style="max-width: 820px;">
    <h5 class="fw-bold text-navy mb-3">New Legal Service Application</h5>
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Title" class="form-label fw-semibold"></label>
                <input asp-for="Title" class="form-control" placeholder="e.g., Renewal of Notary Certificate" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                <select asp-for="CategoryId" class="form-select">
                    <option value="">-- Select Category --</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id">@c.Name (~@c.EstimatedProcessingDays days)</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DepartmentId" class="form-label fw-semibold"></label>
                <select asp-for="DepartmentId" class="form-select">
                    <option value="">-- Select Department --</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
                <span asp-validation-for="DepartmentId" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" rows="4" class="form-control" placeholder="Provide complete context and relevant details..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="DocumentCategory" class="form-label fw-semibold"></label>
                <select asp-for="DocumentCategory" asp-items="Html.GetEnumSelectList<DocumentCategory>()" class="form-select"></select>
            </div>
            <div class="col-md-7">
                <label asp-for="SupportingDocument" class="form-label fw-semibold"></label>
                <input asp-for="SupportingDocument" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                <small class="text-muted">Private storage with extension, size (≤5 MB), and binary content validation.</small>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">Submit Application</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
