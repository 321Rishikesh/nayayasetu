@{
    ViewData["Title"] = "Error";
}
<div class="container py-5 text-center">
    <i class="fa-solid fa-triangle-exclamation text-warning fa-3x mb-3"></i>
    <h2 class="fw-bold">Something went wrong</h2>
    <p class="text-muted">An unexpected error occurred while processing your request. Please try again.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Return Home</a>
</div>
