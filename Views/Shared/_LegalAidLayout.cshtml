<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NyayaSetu Legal Aid Officer</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="dashboard-body">
    <div class="d-flex min-vh-100">
        <!-- Role Sidebar -->
        <aside class="sidebar-nyaya d-flex flex-column p-3 text-white" id="dashboardSidebar">
            <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-2 text-white text-decoration-none mb-3">
                <img src="~/images/nyayasetu-emblem.svg" alt="NyayaSetu" width="34" height="34" />
                <div>
                    <div class="fw-bold lh-1">NyayaSetu</div>
                    <span class="badge bg-success mt-1">Legal Aid Officer</span>
                </div>
            </a>
            <hr class="border-light opacity-25 my-2" />
            <ul class="nav nav-pills flex-column mb-auto gap-1">
                
<li class="nav-item"><a class="nav-link text-white" asp-controller="LegalAid" asp-action="Dashboard"><i class="fa-solid fa-scale-balanced me-2"></i>Legal Aid Desk</a></li>
<li class="nav-item"><a class="nav-link text-white" asp-controller="Notifications" asp-action="Index"><i class="fa-solid fa-bell me-2"></i>Notifications</a></li>
<li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="LegalAidInfo"><i class="fa-solid fa-book-open me-2"></i>Official Resources</a></li>

            </ul>
            <hr class="border-light opacity-25 my-2" />
            <div class="small text-white-50 mb-2">
                <i class="fa-solid fa-user-shield me-1"></i>@User.Identity?.Name
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-light btn-sm flex-fill" asp-controller="Account" asp-action="Profile"><i class="fa-solid fa-user-gear"></i></a>
                <button type="button" class="btn btn-outline-light btn-sm" id="themeToggle" title="Toggle Theme"><i class="fa-solid fa-moon"></i></button>
                <form asp-controller="Account" asp-action="Logout" method="post" class="flex-fill">
                    <button type="submit" class="btn btn-saffron btn-sm w-100 fw-semibold">Logout</button>
                </form>
            </div>
        </aside>

        <!-- Main Workspace -->
        <div class="flex-grow-1 d-flex flex-column">
            <header class="topbar-nyaya px-4 py-3 d-flex justify-content-between align-items-center shadow-sm">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-secondary btn-sm d-lg-none" type="button" onclick="document.getElementById('dashboardSidebar').classList.toggle('show')">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h5 class="mb-0 fw-bold">@ViewData["Title"]</h5>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <a asp-controller="Notifications" asp-action="Index" class="btn btn-light btn-sm position-relative" aria-label="Notifications">
                        <i class="fa-solid fa-bell"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="notifBadge">0</span>
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm">Public Portal</a>
                </div>
            </header>

            <main class="p-4 flex-grow-1">
                <partial name="_ToastNotifications" />
                @RenderBody()
            </main>

            <footer class="px-4 py-2 small text-muted border-top d-flex justify-content-between">
                <span>NyayaSetu Academic Prototype — Legal Aid Officer Workspace</span>
                <span>Not an official Government of India website</span>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
