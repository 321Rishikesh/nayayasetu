@inject ILocalizationService Loc
@{
    var lang = Context.Request.Cookies["NyayaSetu.Lang"] ?? "en";
}
<!DOCTYPE html>
<html lang="@lang" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Loc.Get("AppName", lang)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Academic Prototype Transparency Banner -->
    <div class="prototype-banner text-center py-1 px-3 small">
        <i class="fa-solid fa-graduation-cap me-1"></i>
        <strong>@Loc.Get("PrototypeNotice", lang)</strong>
        <span class="ms-2 d-none d-md-inline">|</span>
        <button type="button" class="btn btn-link btn-sm text-white text-decoration-none py-0" id="contrastToggle" title="Toggle High Contrast">
            <i class="fa-solid fa-circle-half-stroke me-1"></i>Contrast
        </button>
        <button type="button" class="btn btn-link btn-sm text-white text-decoration-none py-0" id="themeToggle" title="Toggle Light/Dark Mode">
            <i class="fa-solid fa-moon me-1"></i>Theme
        </button>
        <form asp-controller="Home" asp-action="SetLanguage" method="post" class="d-inline ms-2">
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <select name="lang" onchange="this.form.submit()" class="form-select form-select-sm d-inline-block w-auto py-0 bg-dark text-white border-secondary" aria-label="Language selector">
                <option value="en" selected="@(lang == "en")">English</option>
                <option value="hi" selected="@(lang == "hi")">हिन्दी</option>
                <option value="pa" selected="@(lang == "pa")">ਪੰਜਾਬੀ</option>
            </select>
        </form>
    </div>

    <!-- Main Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-nyaya sticky-top shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/images/nyayasetu-emblem.svg" alt="NyayaSetu Emblem" width="40" height="40" />
                    <div>
                        <div class="fw-bold lh-1 text-white">@Loc.Get("AppName", lang)</div>
                        <small class="text-white-50" style="font-size: 0.72rem;">@Loc.Get("Tagline", lang)</small>
                    </div>
                </a>
                <button class="navbar-toggler border-light" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">@Loc.Get("NavHome", lang)</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">@Loc.Get("NavAbout", lang)</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Services">@Loc.Get("NavServices", lang)</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="LegalAidInfo">@Loc.Get("NavLegalAid", lang)</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Track">@Loc.Get("NavTrack", lang)</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Complaints" asp-action="Index">@Loc.Get("NavGrievances", lang)</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Assistant" asp-action="Index"><i class="fa-solid fa-robot me-1"></i>AI Info</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var dashCtrl = User.IsInRole(AppRoles.SuperAdmin) ? "Admin"
                                : User.IsInRole(AppRoles.DepartmentOfficer) ? "Officer"
                                : User.IsInRole(AppRoles.LegalAidOfficer) ? "LegalAid" : "Citizen";
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-saffron btn-sm fw-semibold" asp-controller="@dashCtrl" asp-action="Dashboard">
                                    <i class="fa-solid fa-gauge-high me-1"></i>Dashboard
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-saffron btn-sm fw-semibold" asp-controller="Account" asp-action="Login">
                                    <i class="fa-solid fa-right-to-bracket me-1"></i>@Loc.Get("NavLogin", lang)
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        <div class="container mt-3">
            <partial name="_ToastNotifications" />
        </div>
        @RenderBody()
    </main>

    <footer class="footer-nyaya mt-5 pt-5 pb-4 text-white">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="fw-bold text-saffron">NyayaSetu</h5>
                    <p class="small text-white-50">
                        Smart Ministry of Law and Justice Management System — an academic prototype demonstrating digital legal service delivery, transparent tracking, and free legal aid workflows.
                    </p>
                    <p class="small text-warning mb-0"><i class="fa-solid fa-circle-info me-1"></i>Not affiliated with or operated by the Government of India.</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="fw-semibold">Portal</h6>
                    <ul class="list-unstyled small">
                        <li><a class="footer-link" asp-controller="Home" asp-action="About">About</a></li>
                        <li><a class="footer-link" asp-controller="Home" asp-action="Services">Services</a></li>
                        <li><a class="footer-link" asp-controller="Home" asp-action="Track">Track Application</a></li>
                        <li><a class="footer-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-3">
                    <h6 class="fw-semibold">Verified Official Resources</h6>
                    <ul class="list-unstyled small">
                        <li><a class="footer-link" href="https://lawmin.gov.in/" target="_blank" rel="noopener">Ministry of Law &amp; Justice</a></li>
                        <li><a class="footer-link" href="https://doj.gov.in/" target="_blank" rel="noopener">Department of Justice</a></li>
                        <li><a class="footer-link" href="https://nalsa.gov.in/" target="_blank" rel="noopener">NALSA (Free Legal Aid)</a></li>
                        <li><a class="footer-link" href="https://services.ecourts.gov.in/" target="_blank" rel="noopener">eCourts Services</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6 class="fw-semibold">Need Information?</h6>
                    <p class="small text-white-50">Use our AI Legal Information Assistant for plain-language explanations of Indian legal terms and portal guidance.</p>
                    <a class="btn btn-outline-light btn-sm" asp-controller="Assistant" asp-action="Index"><i class="fa-solid fa-robot me-1"></i>Open AI Assistant</a>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <div class="d-flex flex-wrap justify-content-between small text-white-50">
                <span>&copy; @DateTime.UtcNow.Year NyayaSetu Academic Prototype</span>
                <span>Built with ASP.NET Core 8.0 MVC, EF Core &amp; SQL Server</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
