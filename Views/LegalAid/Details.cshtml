@model LegalAidRequest
@{
    Layout = User.IsInRole(AppRoles.LegalAidOfficer) || User.IsInRole(AppRoles.SuperAdmin) ? "_LegalAidLayout" : "_CitizenLayout";
    ViewData["Title"] = $"Legal Aid {Model.ReferenceNumber}";
}
<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <span class="badge bg-success mb-2">@Model.ReferenceNumber</span>
            <h4 class="fw-bold text-navy">@Model.CaseType</h4>
            <small class="text-muted">Applicant: @Model.Citizen?.FullName &bull; Income: INR @Model.AnnualIncome.ToString("N0") &bull; @Model.EligibilityCategory</small>
        </div>
        <span class="badge bg-info text-dark fs-6">@Model.Status</span>
    </div>
    <p>@Model.CaseSummary</p>
    @if (!string.IsNullOrWhiteSpace(Model.OfficerNotes))
    {
        <div class="alert alert-light border-start border-4 border-success small"><strong>Officer Notes:</strong> @Model.OfficerNotes</div>
    }

    @if (User.IsInRole(AppRoles.LegalAidOfficer) || User.IsInRole(AppRoles.SuperAdmin))
    {
        <hr />
        <form asp-action="UpdateProgress" method="post" class="row g-3">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" asp-items="Html.GetEnumSelectList<LegalAidStatus>()" class="form-select"></select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check">
                    <input type="checkbox" name="isEligible" value="true" checked="@Model.IsEligible" class="form-check-input" id="eligCheck" />
                    <label class="form-check-label small" for="eligCheck">Confirmed Eligible for Free Legal Aid</label>
                </div>
            </div>
            <div class="col-12">
                <label class="form-label small fw-semibold">Officer Notes / Assistance Progress</label>
                <textarea name="officerNotes" rows="3" class="form-control">@Model.OfficerNotes</textarea>
            </div>
            <div class="col-12"><button type="submit" class="btn btn-success btn-sm">Update Legal Aid Case</button></div>
        </form>
    }
</div>
