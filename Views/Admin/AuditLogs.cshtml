@model List<AuditLog>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "System Audit Logs";
}
<div class="card border-0 shadow-sm rounded-4 p-4">
    <h6 class="fw-bold text-navy mb-3">Recent Security &amp; Activity Audit Trail</h6>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle small">
            <thead class="table-light"><tr><th>Timestamp (UTC)</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead>
            <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td class="text-nowrap">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@(log.UserEmail ?? "System")</td>
                    <td><span class="badge bg-secondary">@log.Action</span></td>
                    <td>@log.EntityName (@log.EntityId)</td>
                    <td class="text-muted">@log.Details</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
