@model CreateComplaintViewModel
@{
    Layout = "_CitizenLayout";
    ViewData["Title"] = "Register Grievance";
}
<div class="card border-0 shadow-sm rounded-4 p-4 mx-auto" style="max-width: 760px;">
    <h5 class="fw-bold text-navy mb-3">Register a New Grievance / Complaint</h5>
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Subject" class="form-label fw-semibold"></label>
                <input asp-for="Subject" class="form-control" />
                <span asp-validation-for="Subject" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Category" class="form-label fw-semibold"></label>
                <select asp-for="Category" class="form-select">
                    <option>Service Delay</option>
                    <option>Document Verification Issue</option>
                    <option>Legal Aid Access</option>
                    <option>Technical / Portal</option>
                    <option>Other</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Priority" class="form-label fw-semibold"></label>
                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<ComplaintPriority>()" class="form-select"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="DepartmentId" class="form-label fw-semibold"></label>
                <select asp-for="DepartmentId" class="form-select">
                    <option value="">-- Optional --</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-danger mt-4 px-4">Submit Grievance</button>
    </form>
</div>
